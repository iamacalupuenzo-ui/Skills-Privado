{
  "name": "skils",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform installer for the shared Codex and Claude Code skills catalog.",
  "type": "module",
  "bin": {
    "skils": "bin/skils.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --check bin/skils.js && node scripts/validate-skills.mjs && node scripts/probar-paridad.mjs",
    "preparar-publicacion": "node scripts/preparar-publicacion.mjs",
    "construir-plugin": "node scripts/construir-plugin.mjs",
    "sync:angular": "node scripts/sync-angular-skills.mjs",
    "sync:anatomy": "node scripts/sync-anatomy-skill.mjs",
    "test:guards": "node skills/orquestador-desarrollo/hooks/probar-guardia.mjs && node skills/orquestador-desarrollo/hooks/probar-guardias-universales.mjs && node skills/em-orquestador-ux/hooks/probar-guardia-uxs.mjs",
    "test:environment": "node scripts/probar-entorno-skills.mjs",
    "test:parity": "node scripts/probar-paridad.mjs"
  },
  "files": [
    "bin/",
    "skills/",
    "packs/",
    "plugins/",
    "skills-manifest.json",
    "README.md",
    "docs/",
    "scripts/"
  ],
  "license": "UNLICENSED"
}
