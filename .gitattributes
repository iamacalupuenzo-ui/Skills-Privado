skills/orquestador-desarrollo/hooks/shims/* text eol=lf
skills/orquestador-desarrollo/hooks/shims/*.cmd text eol=crlf
plugins/*/skills/orquestador-desarrollo/hooks/githooks/* text eol=lf
plugins/*/skills/orquestador-desarrollo/hooks/shims/* text eol=lf
plugins/*/skills/orquestador-desarrollo/hooks/shims/*.cmd text eol=crlf
